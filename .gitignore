!/E14/.config/hypr/scripts/power-menu.sh
!/E14/.config/hypr/scripts/power-menu.py
!/E14/.config/hypr/scripts/shortcut-help.py
!/E14/.config/kiorc
!/E14/.config/kdeglobals
!/E14/.config/menus/applications.menu
!/E14/.config/hypr/scripts/start-session.sh
!/E14/.config/systemd/user/e14-session.target
!/E14/.config/systemd/user/e14-session-watch.service
!/E14/.config/systemd/user/e14-clipboard@.service
!/E14/.config/systemd/user/e14-handy.service
!/E14/.config/systemd/user/e14-nm-applet.service
!/E14/.config/systemd/user/e14-music-island.service
!/E14/.config/systemd/user/e14-right-islands.service
!/E14/.config/systemd/user/blueman-applet.service.d/session.conf
!/E14/.config/mimeapps.list
!/E14/.config/island-shared/fluid-reveal.ts
!/E14/.config/island-shared/style.css
!/E14/.config/music-island/app.tsx
!/E14/.config/music-island/metadata.py
!/E14/.config/music-island/style.css
!/E14/.config/music-island/weather.tsx
!/E14/.config/music-island/weather.py
!/E14/.config/pavucontrol.ini
!/E14/.config/right-islands/app.tsx
!/E14/.config/right-islands/status.py
!/E14/.config/right-islands/style.css
