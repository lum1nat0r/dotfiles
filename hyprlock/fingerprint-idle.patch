+void CFingerprint::cancelTimers() {
+    if (m_pInactivityTimer) {
+        m_pInactivityTimer->cancel();
+        m_pInactivityTimer.reset();
+    }
+    if (m_pRetryTimer) {
+        m_pRetryTimer->cancel();
+        m_pRetryTimer.reset();
+    }
+}
+
+void CFingerprint::onActivity() {
+    if (m_iInactiveTimeout <= 0 || m_sDBUSState.abort || m_sDBUSState.done || m_sDBUSState.sleeping || g_pHyprlock->isFadingOutOrTerminating())
+        return;
+
+    if (m_sDBUSState.paused) {
+        m_sDBUSState.paused = false;
+        Log::logger->log(Log::INFO, "fprint: activity detected, resuming verification");
+        startVerify();
+    } else if (m_sDBUSState.verifying)
+        m_tLastActivity = std::chrono::steady_clock::now();
+}
+
+void CFingerprint::checkInactivity() {
+    if (m_iInactiveTimeout <= 0 || m_sDBUSState.abort || m_sDBUSState.done || !m_sDBUSState.verifying)
+        return;
+
+    const auto remaining = std::chrono::seconds(m_iInactiveTimeout) - (std::chrono::steady_clock::now() - m_tLastActivity);
+    if (remaining > std::chrono::steady_clock::duration::zero()) {
+        // Activity moves the deadline without allocating a timer for every pointer event.
+        m_pInactivityTimer = g_pHyprlock->addTimer(
+            remaining,
+            [this](ASP<CTimer> self, void* data) {
+                if (self != m_pInactivityTimer)
+                    return;
+                m_pInactivityTimer.reset();
+                checkInactivity();
+            },
+            nullptr);
+        return;
+    }
+
+    m_sDBUSState.paused = true;
+    Log::logger->log(Log::INFO, "fprint: inactivity timeout, pausing verification");
+    stopVerify();
+    releaseDevice();
+    m_sPrompt.clear();
+    g_pHyprlock->enqueueForceUpdateTimers();
+}
