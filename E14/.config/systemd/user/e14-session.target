[Unit]
Description=E14 Hyprland desktop services
Requires=graphical-session.target
BindsTo=e14-session-watch.service
After=graphical-session.target e14-session-watch.service
PropagatesStopTo=graphical-session.target
Wants=swaync.service hypridle.service waybar.service hyprpolkitagent.service
Wants=xdg-desktop-portal-hyprland.service xdg-desktop-portal.service
Wants=e14-clipboard@text.service e14-clipboard@image.service
Wants=e14-handy.service e14-nm-applet.service
Wants=blueman-applet.service
Wants=e14-music-island.service e14-right-islands.service
Wants=e14-hyprshell.service
