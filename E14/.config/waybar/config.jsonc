{
  "layer": "top",
  "position": "top",
  "height": 44,
  "passthrough": false,
  "margin-top": 9,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": [],
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces"],
  },
  "group/island": {
    "orientation": "horizontal",
    "modules": ["clock"],
  },
  "group/stats": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature", "battery"],
  },
  "group/controls": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth",
      "pulseaudio",
      "pulseaudio#mic",
      "custom/notifications",
      "tray",
    ],
  },

  "hyprland/workspaces": {
    "format": "{name} {windows}",
    "format-window-separator": " ",
    "sort-by-number": true,
    "all-outputs": true,
    "show-special": false,
    "persistent-workspaces": {
      "*": [1, 2, 3],
    },
    "window-rewrite-default": "󰣆",
    "window-rewrite": {
      "class<kitty>": "󰆍",
      "class<firefox>": "󰈹",
      "class<org.mozilla.firefox>": "󰈹",
      "class<chromium>": "󰊯",
      "class<org.kde.dolphin>": "󰉋",
      "class<dolphin>": "󰉋",
      "class<code>": "󰨞",
      "class<Code>": "󰨞",
      "class<Spotify>": "󰓇",
      "class<spotify>": "󰓇",
      "class<discord>": "󰙯",
      "class<steam>": "󰓓",
    },
  },
  "clock": {
    "interval": 30,
    "format": "󰥔  {:%H:%M  ·  %a %d.%m.}",
    "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
  },
  "cpu": {
    "interval": 3,
    "format": "  {usage}%",
    "tooltip": true,
  },
  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip": true,
  },
  "temperature": {
    "interval": 5,
    "format": " {temperatureC}°",
    "critical-threshold": 85,
    "format-critical": " {temperatureC}°",
  },
  "battery": {
    "interval": 20,
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 25,
      "critical": 12,
    },
  },
  "network": {
    "interval": 5,
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid} · {signalStrength}%",
    "on-click": "sh -c 'nm-connection-editor >/dev/null 2>&1 &'",
    "on-click-right": "sh -c 'kitty -e nmtui &'",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{status}",
    "on-click": "sh -c 'blueman-manager >/dev/null 2>&1 &'",
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["", "", ""],
    },
    "tooltip-format": "Audio {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "sh -c 'pavucontrol >/dev/null 2>&1 &'",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
  },
  "pulseaudio#mic": {
    "format": "",
    "format-muted": "",
    "tooltip-format": "Microphone {volume}%",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "sh -c 'pavucontrol >/dev/null 2>&1 &'",
    "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 2,
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d -sw",
  },
  "tray": {
    "icon-size": 16,
    "spacing": 7,
  },
}
