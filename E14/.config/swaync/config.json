{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "cssPriority": "user",
  "control-center-margin-top": 12,
  "control-center-margin-bottom": 12,
  "control-center-margin-right": 12,
  "control-center-margin-left": 12,
  "control-center-width": 420,
  "notification-window-width": 444,
  "fit-to-screen": true,
  "notification-grouping": true,
  "relative-timestamps": true,
  "keyboard-shortcuts": true,
  "timeout": 10,
  "timeout-low": 5,
  "timeout-critical": 0,
  "text-empty": "Keine Mitteilungen",
  "widgets": ["inhibitors", "title", "dnd", "notifications"],
  "widget-config": {
    "title": {"text": "Mitteilungen", "clear-all-button": true, "button-text": "Alle löschen"},
    "dnd": {"text": "Nicht stören"},
    "inhibitors": {"text": "Unterdrückung aktiv", "button-text": "Aufheben", "clear-all-button": true},
    "notifications": {"vexpand": true}
  }
}
